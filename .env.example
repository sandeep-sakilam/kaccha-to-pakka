# Copy to .env and fill in. Every adapter runs as a mock (labelled "Sandbox") until its keys are present.
# Never commit .env.

# --- Core ---
APP_ENV=development
# Postgres URL. Local default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://ktp:ktp@localhost:5432/ktp
REDIS_URL=redis://localhost:6379/0
# Random 64-char secret for session tokens: `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=
# Ed25519 passport signing key, base64 of 32-byte seed. Generate: `make signing-key`. Keep in a KMS in production.
PASSPORT_SIGNING_KEY=
# Public base URL used in QR codes and share links.
PUBLIC_BASE_URL=http://localhost:5173
# Key-encryption key for field-level encryption (base64 32 bytes). Production: managed KMS in an Indian region.
FIELD_ENCRYPTION_KEY=

# --- Adapter selection: "auto" (real when its keys below are set, else mock), "mock" or "real". ---
AI_PROVIDER=auto
FALLBACK_AI_PROVIDER=auto
AA_PROVIDER=auto
PAYMENTS_PROVIDER=auto
WHATSAPP_PROVIDER=auto
KYC_PROVIDER=auto
STORAGE_PROVIDER=local
SMS_PROVIDER=auto

# --- Sarvam AI (Vision, Saaras v3 STT, Bulbul v3 TTS, Sarvam-105B) ---
# Get from https://dashboard.sarvam.ai -> API keys
SARVAM_API_KEY=

# --- Fallback AI: Gemini or Anthropic (one is enough) ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# "gemini" or "anthropic"
FALLBACK_AI_VENDOR=gemini

# --- Account Aggregator (Setu AA sandbox) ---
# Get from https://bridge.setu.co -> Account Aggregator -> sandbox credentials
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_PRODUCT_INSTANCE_ID=
AA_BASE_URL=https://fiu-sandbox.setu.co

# --- Payment gateway with reverse penny drop (Cashfree or Razorpay sandbox) ---
# Cashfree: https://merchant.cashfree.com -> Developers -> API keys (test mode)
PAYMENTS_CLIENT_ID=
PAYMENTS_CLIENT_SECRET=
PAYMENTS_BASE_URL=https://sandbox.cashfree.com
# Verification UPI ID that confirmers pay Rs 1 to
VERIFICATION_VPA=verify@sandbox

# --- WhatsApp (Meta Cloud API, or Twilio sandbox for development) ---
# Meta: https://developers.facebook.com -> your app -> WhatsApp -> API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio: https://console.twilio.com -> Messaging -> Try WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- SMS fallback for OTP (e.g. MSG91): https://control.msg91.com -> API ---
SMS_API_KEY=

# --- KYC (DigiLocker / PAN via licensed provider, e.g. Setu or Surepass) ---
KYC_API_KEY=
KYC_BASE_URL=

# --- S3-compatible storage in an Indian region (e.g. AWS ap-south-1, E2E Networks) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
LOCAL_STORAGE_DIR=./var/storage

# --- Monitoring (optional): https://sentry.io -> project -> Client keys (DSN) ---
SENTRY_DSN=
